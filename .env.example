# Server
PORT=8000
HOST=0.0.0.0
PROJECT_NAME="Grand Azure Palace & Resort ERP"

# MongoDB Database Connection
# Local MongoDB: mongodb://localhost:27017
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/hotel_erp_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=hotel_erp_db

# Supabase Realtime & Authentication (India Client)
# Retrieve from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Frontend Supabase Keys (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Security & Local JWT
JWT_SECRET=super_secret_indian_hospitality_erp_jwt_key_2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Payment Gateway Configuration (India Market)
# Options: "razorpay" (Standard for India) | "mock" (Instant Built-in UPI/Card Sandbox) | "stripe"
PAYMENT_PROVIDER=razorpay

# Razorpay Configuration (India UPI, Net Banking, RuPay/Cards)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

